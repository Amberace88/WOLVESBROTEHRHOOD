{
  // Wolves Brotherhood MC — viens Worker: statiskā lapa (dist/) + /api/*
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wolvesbrotherhood",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "wolves", "database_id": "AIZPILDI_PĒC_wrangler_d1_create" }
  ],
  "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "Room" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room"] } ],
  "vars": { "ADMIN_EMAIL": "" },
  "routes": [
    { "pattern": "wolvesbrotherhoodmc.com", "custom_domain": true },
    { "pattern": "www.wolvesbrotherhoodmc.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
